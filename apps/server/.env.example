# ==== 数据库 ====
DATABASE_URL=postgres://mock:mock@localhost:5432/mock_interview

# ==== 认证 ====
JWT_SECRET=dev-secret-change-me

# ==== DeepSeek（LLM）===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==== 语音 ====
# mock：无 Key 也可跑通全流程（STT 返回演示文本 / TTS 返回文字）
# alibaba：阿里云百炼 Paraformer + CosyVoice
# openai：OpenAI Whisper
STT_PROVIDER=mock
TTS_PROVIDER=mock
ALIYUN_DASHSCOPE_API_KEY=

# ==== 对象存储（MVP 用本地文件系统即可）====
S3_ENDPOINT=
S3_BUCKET=recordings

# ==== 前端地址（CORS）====
PUBLIC_URL=http://localhost:5173

PORT=3000